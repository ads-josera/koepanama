<header id="site-header" class="header">
  {% block head %}
  {# Header #}
  <div id="header-wrap" class="menu-principal text-uppercase bg__uni--white">

    <nav id="navbar_km" class="navbar_air navbar navbar-expand-lg fixed-top">

      {# Left #}
      <a class="navbar-brand logo logo-color" href="{{ path('<front>') }}">
        <img id="logo-img" class="img-center" src="{{ base_path ~ directory }}/logo.svg"/>
      </a>
      <a class="navbar-brand logo logo-white" href="{{ path('<front>') }}">
        <img id="logo-img" class="img-center" src="{{ base_path ~ directory }}/logo-white.svg"/>
      </a>
      {# Right #}
      {% if page.menuuser %}
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarCollapse" aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon mt-2"><i class="fas fa-bars"></i></span>
        </button>
        <div class="collapse navbar-collapse justify-content-end" id="navbarCollapse">
          {{ page.menuuser }}
          <div class="navbar-toggler close-navbar bg__theme--primary font__size--lg font__letter-spacing--1" data-toggle="collapse" data-target="#navbarCollapse" aria-controls="navbarCollapse" aria-expanded="false">CLOSE <i class="fa fa-times"></i></div>
        </div>
      {% endif %}

    </nav>

  </div>
  {% endblock %}
</header>