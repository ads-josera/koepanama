<div class="page-content user-login">

  <section class="login">
    <div class="container">
      <div class="row">

        <div class="col-lg-6 col-md-10 align-self-center">
          <div class="login-form p-4">
            <a class="main-logo d-block p-0 w-50" href="{{ path('<front>') }}"rel="home">
              <img class="logo-user-page" src="{{ base_path ~ directory }}/logo.svg"/>
            </a>

            <h2 class="subtitulo-login">KOE PANAMÁ</h2>
            <h1 class="titulo-login">Administrador de Contratos</h1>

            {# System #}
            {% if page.system %}
              <div class="system-content_theme"> 
                {{ page.system }}
              </div>
            {% endif %}
            
            <div class="formulario-login"> 
              {{ page.content }}
            </div>

          </div>
        </div>
  
        <div class="col-12">
          <div class="copy-login">Copyright © KOE.COM.PA {{ "now"|date('Y') }}</div>
        </div>

      </div>
    </div>

  </section>

</div>



        