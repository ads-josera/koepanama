<div class="layout has-sidebar fixed-sidebar fixed-header">
  <aside id="sidebar" class="sidebar break-point-lg has-bg-image">

    <div class="image-wrapper">
      <img src="{{ base_path ~ directory }}/images/bg-sidebar.jpg"/>
    </div>

    <div class="sidebar-layout">
      <div class="sidebar-header">
        <img class="logo-dash" src="{{ base_path ~ directory }}/logo.svg"/>
      </div>
      <div class="sidebar-content">
        {# Menu Usuario #}
        {% if page.menu %}
          <section class="menu_user-content_theme">
            <div class="container-fluid"> 
              <div class="row clearfix">
                <div class="col-12"> 
                  {{ page.menu }}
                </div>
              </div>
            </div>
          </section>
        {% endif %}
      </div>
      <div class="sidebar-footer">
        {% include "@koecontrato/layout/footer.html.twig" %}
      </div>
    </div>

  </aside>

  <div class="layout page-folios">
    <div class="header header-color-azul justify-content-between">
      <div class="accion-menu">
        <a id="btn-collapse" href="#">
          MENÚ
        </a>
        <a id="btn-toggle" href="#" class="sidebar-toggler break-point-lg">
          
        </a>
      </div>
      {% include "@koecontrato/layout/header-user.html.twig" %}
    </div>
    {# Contenido #}
    <main class="content">
    {# System #}
    {% if page.system %}
      <section class="system-content_theme">
        <div class="container"> 
          <div class="row clearfix">
            <div class="col-12"> 
              {{ page.system }}
            </div>
          </div>
        </div>
      </section>
    {% endif %}
  {# Main content #}
  {% if page.content %}
    <section class="main-content_theme">
      <div class="container pb-5"> 
        <div class="row clearfix">
          {% if 'vendedor' in user.getroles(TRUE) %}
            <div class="col-12 encabezado-rol encabezado-ejecutivo">
              <h3 class="titulo-folio">MIS FOLIOS</h3>
              <div class="banner-img banner-folios"></div>
              <p>Esta lista es de carácter informativo y corresponde a los folios realizados por el asesor. NO IMPLICA que estos consecutivos sean Matrículas OK. Para conocer las matrículas efectivas por favor diríjase a DPS para consulta.</p>
            </div>
          {% endif %}
          {% if 'master' in user.getroles(TRUE) %}
            <div class="col-12 encabezado-rol encabezado-master">
              <h3 class="titulo-folio">PUBLICIDAD KOE</h3>
              <div class="banner-img banner-master"></div>
            </div>
          {% endif %}
          {% if 'submaster' in user.getroles(TRUE) %}
            <div class="col-12 encabezado-rol encabezado-master">
              <h3 class="titulo-folio">FOLIOS KOE</h3>
              <div class="banner-img banner-master"></div>
            </div>
          {% endif %}
          {% if 'supervisor' in user.getroles(TRUE) %}
            <div class="col-12 encabezado-rol encabezado-supervisor">
              <h3 class="titulo-folio">KOE MÉXICO | CONTRATOS</h3>
              <div class="banner-img banner-supervisor"></div>
            </div>
          {% endif %}
          <div class="col-12">
            {{ page.content }}
          </div>
        </div>
      </div>
    </section> 
  {% endif %}
  
  </div>
</div>

<div id="km-modal-loading" class="mfp-hide km-loading">
  <div class="km-txtload">Procesando</div>
  <div class="km-load"><hr/><hr/><hr/><hr/></div>
</div>

{% block javascript %}
  <script src="{{ base_path ~ directory }}/js/sidebar.js" type="text/javascript"></script>
{% endblock %}