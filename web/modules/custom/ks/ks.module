 function ks_preprocess_html(&$variables) {
   $route = \Drupal::routeMatch();
   
   $route_name = $route->getRouteName();
   
   $url = '';
   try{
      $url = Url::fromRoute($route_name);
      $url = str_ireplace('/', '-', trim($url->toString(), '/'));
    }catch(\Exception $e){
      $url = '';
    }
   
   $variables['route_name'] = $route_name;   
   $variables['attributes']['class'][] = $url;
   
   $bag = $route->getParameters();
   if($bag->has('node')){
     $node = $bag->get('node');     
     $variables['attributes']['class'][] = 'node-'.$node->getType();
     $variables['attributes']['class'][] = 'node-'.$node->id();
   }
   
   if($bag->has('webform')){
     $webform = $bag->get('webform');
     $variables['attributes']['class'][] = 'webform';
     $variables['attributes']['class'][] = 'webform-'.(is_string($webform)? $webform:$webform->id());
    }
    
    $roles = \Drupal::currentUser()->getRoles();
    foreach ($roles as $role) {
      $variables['attributes']['class'][] = "role-{$role}";
    }
 }
   
 function ks_form_alter(&$form, FormStateInterface $form_state, $form_id){   
   switch($form_id){
     case 'user_login_form':
       array_unshift($form['#validate'], 'ks_user_login_form_validate');
       $form['#submit'][] = 'ks_user_login_form_submit';
     break;
   }
 }
 
 function ks_user_login_form_validate($form, FormStateInterface $form_state) {   
   $values = $form_state->getValues();
   $username = trim($values['name']);
   $password = trim($values['pass']);
   
   if ( empty( $username ) || empty( $password ) ) return;
   
   $account = user_load_by_name($username);
   if(!$account) $account = user_load_by_mail($username);
   
   error_log($username);
   
   if($account){
     if(!$account->hasRole('vendedor')){
       error_log('El usuario existe, no es un vendedor, continúa el flujo normal...');
       return;//El usuario existe, no es un vendedor, por lo que continúa el flujo normal			
     }
   }
   
   error_log('El usuario es vendedor o no está registrado.');
   
   if(filter_var($username, FILTER_VALIDATE_EMAIL) == FALSE){
     error_log('$username no es correo.');
     $form_state->setErrorByName('name', t('Para iniciar sesión utilice su correo electrónico y contraseña'));
     return;
   }
   error_log('$username es correo, validando en el DPS...');
   
   $dps_user = Folio::koe_api_call('api/user/global', ['username' => $username, 'password' => $password, 'picture' => false], 'POST', false);
   if(!isset($dps_user['authenticated'])){
     if($account) $form_state->setErrorByName('name', t('Para iniciar sesión utilice su correo electrónico y contraseña registrados en el DPS KOE'));
     return; 
   }
  
   error_log('Usuario firmado en el DPS.');
   
   $email = $username;
   $form_state->setValue('pass', Folio::VENDEDOR_PASSWORD);
   
   if(!$account){
     $username = $dps_user['userName'];
     error_log('El usuario parece no existir, procediendo a validar la información...');
     if (!user_load_by_mail( $email ) ) {
       error_log('El usuario no existe, creando nuevo usuario...');       
       $account = Folio::koe_account_create($email, $username);
     } 
   }
   
   Folio::koe_session('user_id', $account->id());
   Folio::koe_session('userName', $dps_user['userName']);
   Folio::koe_session('codUsuario', $dps_user['codUsuario']);
   
   //Obteniendo Token
   koe_token_retrieve($email, $password);
   Folio::koe_session('emailoperador', $email);
   
   //Sedes/filiales
   $paisSistema = 1;//1 = pa, 6 => mx; País sistema de esta instalación
   
   $paises = $dps_user['paises'];
   foreach($paises as $pais){
     if($pais['cod'] == $paisSistema) break;//if($pais['defaultCountry'] == true) break;     
   }
   $codPais = $pais['cod'];
   Folio::koe_session('codPais', $codPais);
   
   $sedeDefault = $dps_user['sedeOmision']['idsede'];
   Folio::koe_session('sedeDefault', $sedeDefault);
   
   $sedes = $pais['sedesacceso'];
   Folio::koe_session('sedes', $sedes);
   
   $filiales = [];
   $sedes = Folio::koe_api_call('api/online/filiales/'.$codPais, [], 'GET', true);
   foreach($sedes as $sede){
     $sede_filiales = $sede['filiales'];
     
     $filiales[$sede['idsede']] = $sede_filiales;
     
     foreach($sede_filiales as $filial){
       $id_filial = $filial['iD_Filial'];
       $result = Drupal::entityTypeManager()->getStorage('filial')->loadByProperties(['field_id' => $id_filial]);
       if(!$result){
         $item = Filial::create(['field_id' => $id_filial, 'label' => $filial['nombre']]);
         $item->save();
       }       
     }
   }
   Folio::koe_session('filiales', $filiales);
   
   //Planes
   $planes = Folio::koe_api_call('api/online/plan/'.$codPais, [], 'GET', true);
   Folio::koe_session('planes', $planes);
   
   //Servicios
   $servicios = Folio::koe_api_call('api/online/tipocontrato/', [], 'GET', true);
   Folio::koe_session('servicios', $servicios);
  
   $form_state->setValidationComplete();
   $url = $account->hasRole('vendedor')? Url::fromUri('internal:/contrato'):Url::fromUri('internal:/verificacion/datos-de-facturacion');
   $form_state->setRedirectUrl($url);   
 }
 
 function koe_token_retrieve($email, $password){
   $result = Folio::koe_api_call('token', ['username' => $email, 'password' => $password, 'grant_type' => 'password'], 'POST', false, 'application/x-www-form-urlencoded');
   if(isset($result['access_token'])) Folio::koe_session('token', $result['access_token']);
 }
 
 function ks_user_login_form_submit($form, FormStateInterface $form_state) {
   $name = $form_state->getValue('name');
   $account = user_load_by_name($name);
   if($account){    
     $url = $account->hasRole('vendedor')? Url::fromUri('internal:/contrato'):Url::fromUri('internal:/user');
     $form_state->setRedirectUrl($url);
   }
 }
 
