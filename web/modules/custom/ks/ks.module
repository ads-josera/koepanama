 function ks_webform_submission_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {     
     $form['#attached']['library'][] = 'ks/ks';
     
     if($form['#webform_id'] == 'contrato'){
       $form['#attached']['library'][] = 'ks/iti-fix';
     }     
 }
  
function ks_webform_element_alter(array &$element, \Drupal\Core\Form\FormStateInterface $form_state, array $context) {    
    $webform = $context['form'];    
    if(!isset($webform['#webform_id']) || !isset($element['#webform_key'])) return;
    
    $webform_id = $webform['#webform_id'];
    if(!in_array($webform_id, ['contrato', 'bienvenida', 'chequeo', 'facturacion', 'entrega'])){
      return;
    }
      
    //General
    switch($element['#webform_key']){
      case 'folio':
        if($webform_id != 'contrato'){
          $element['#default_value'] = Folio::koe_folio($webform_id);
        }
        break;
      case 'revisar_pdf':
        $element['#prefix'] = '<div id="revisar-pdf-wrapper">';
        $element['#suffix'] = '</div>';
        
        $data = $form_state->getValues();
        if(!empty($data)){
          $url = koe_pdf_procesar($webform_id, $data, true);
          $form_state->set('pdf_url', $url);
                   
          $element['#text'] = '<p><iframe height="700" src="'.$url.'#toolbar=1" width="550"></iframe></p>';
        }
        
        break;
      case 'revisar_trigger':
        $element['#ajax'] = [
            'callback' => 'ks_revisar_pdf_change',
            'event' => 'change',
            'wrapper' => 'revisar-pdf-wrapper',
            'progress' => ['type' => 'bar', 'message' => '']
        ];
        break;
      case 'attachment_url':
        if($webform_id != 'contrato'){
          $folio = Folio::koe_folio($webform_id);
          $element['#default_value'] = Pdf::getFileRoute($webform_id, $folio);
        }        
        break; 
    }
    
    
    switch($webform_id){
      case 'contrato':
        if(!Folio::koe_session('codUsuario')) return;
        
        switch($element['#webform_key']){
          case 'contrato_filial':
            $element['#prefix'] = '<div id="filial-wrapper">';
            $element['#suffix'] = '</div>';
            
            $idSede = $form_state->getValue('contrato_sede');
            if(!$idSede) $idSede = Folio::koe_session('sedeDefault');
            
            $options = [];
            $filiales = Folio::koe_session('filiales');
            $filiales = isset($filiales[$idSede])? $filiales[$idSede]:reset($filiales);
            
            foreach($filiales as $filial){
              $options[$filial['iD_Filial']] = $filial['nombre'];
            }
            $element['#options'] = $options;
            break;
          case 'contrato_sede':
            $sedeDefault = Folio::koe_session('sedeDefault');
            $sedes = Folio::koe_session('sedes');
             
            if($sedes){
              $options = [];
              foreach($sedes as $sede){
                 $options[$sede['idsede']] = $sede['nombre'];
              }
              $element['#options'] = $options;
              $element['#default_value'] = $sedeDefault;//Este se permite pues el ejecutivo esta atado a una sede
            }
            
            $element['#ajax'] = [
                'callback' => 'ks_sede_change',
                'event' => 'change',
                'wrapper' => 'filial-wrapper',
                'progress' => ['type' => 'throbber', 'message' => '']
            ];
            break;
          case 'comprador_dato':
            $element['#ajax'] = [
                'callback' => 'ks_dato_change',
                'event' => 'change',
                'progress' => ['type' => 'throbber', 'message' => '']
            ];
            break;
          case 'comprador_nacimiento':
            $element['#ajax'] = [
              'callback' => 'ks_comprador_nacimiento_change',
              'event' => 'focusout',
              'disable-refocus' => true,
              'progress' => ['type' => 'throbber', 'message' => '']
            ];
            break;
          case 'beneficiarios_uno_nacimiento':
            $element['#ajax'] = [
              'callback' => 'ks_beneficiarios_uno_nacimiento_change',
              'event' => 'focusout',
              'disable-refocus' => true,
              'progress' => ['type' => 'throbber', 'message' => '']
            ];
          break;
          case 'beneficiarios_dos_nacimiento':
            $element['#ajax'] = [
              'callback' => 'ks_beneficiarios_dos_nacimiento_change',
              'event' => 'focusout',
              'disable-refocus' => true,
              'progress' => ['type' => 'throbber', 'message' => '']
            ];
          break;
          case 'pagare_nacimiento':
          $element['#ajax'] = [
            'callback' => 'ks_pagare_nacimiento_change',
            'event' => 'focusout',
            'disable-refocus' => true,
            'progress' => ['type' => 'throbber', 'message' => '']
          ];
          break;
          case 'beneficiarios_uno_edad':
          case 'beneficiarios_dos_edad':
            $element['#ajax'] = [
                'callback' => 'ks_edad_change',
                'event' => 'change',
                'progress' => ['type' => 'throbber', 'message' => '']
            ];
            break;
          case 'beneficiarios_uno_servicio':
          case 'beneficiarios_dos_servicio':
            $servicios = Folio::koe_session('servicios');
             
            if($servicios){
              $options = [];
              foreach($servicios as $servicio){
                 $options[$servicio] = $servicio;
              }
              $element['#options'] = $options;
            }
            /*$element['#ajax'] = [//No funciona correctamente debido a que se desfasan el max y min en la validación, basta con el edad_change.
                'callback' => 'ks_servicio_change',
                'event' => 'change',
                'progress' => ['type' => 'throbber', 'message' => '']
            ];*/
            break;          
          case 'condiciones_plan':
              $element['#prefix'] = '<div id="plan-wrapper">';
              $element['#suffix'] = '</div>';
              
              $options = [];
              $planes = Folio::koe_session('planes');
              foreach($planes as $plan){
                $options[$plan['idPlan']] = $plan['idPlan'].' - '.$plan['codPlan'].' - '.$plan['descripcion'];
              }
              $element['#options'] = $options;
              $element['#ajax'] = [
                  'callback' => 'ks_plan_change',
                  'event' => 'change',
                  'progress' => ['type' => 'throbber', 'message' => '']
              ];
            break;
          case 'condiciones_precio':
            $element['#ajax'] = [
                'callback' => 'ks_precio_change',
                'event' => 'change',
                'progress' => ['type' => 'throbber', 'message' => '']
            ];
          break;
          
          case 'clausulas_nombre':
            $element['#default_value'] = Folio::koe_session('userName');//Estos también se permiten aquí, pues no deberían variar
          break;
          case 'clausulas_rfc':
            $element['#default_value'] = Folio::koe_session('codUsuario');//Estos también se permiten aquí, pues no deberían variar
          break;
        }
      break;
      
    }
  }
  
  function ks_revisar_pdf_change(array &$form,\Drupal\Core\Form\FormStateInterface $form_state) {
    return $form['elements']['revisar']['revisar_pdf'];
  } 
  function ks_sede_change(array &$form,\Drupal\Core\Form\FormStateInterface $form_state) {
    return $form['elements']['datosgenerales']['ct_col2']['contrato_filial'];
  }
  function ks_dato_change(array &$form,\Drupal\Core\Form\FormStateInterface $form_state) {
    $response = new AjaxResponse();
    
    $idDato = trim($form_state->getValue('comprador_dato'));
    if(!$idDato) $idDato = 0;
    
    $result = Folio::koe_api_call('api/online/dato/'.$idDato, [], 'GET', true);
    if(isset($result['message'])){
      $response->addCommand(new InvokeCommand('[data-drupal-selector="edit-comprador-dato"]', 'val', ['']));
      $response->addCommand(new AlertCommand($result['message']));
    }else{
      $response->addCommand(new InvokeCommand('[data-drupal-selector="edit-comprador-nombre"]', 'val', [$result['nombre'].' '.$result['apellido']]));
      $response->addCommand(new InvokeCommand('[data-drupal-selector="edit-comprador-correo"]', 'val', [$result['email']]));
      $response->addCommand(new InvokeCommand('[data-drupal-selector="edit-comprador-domicilio"]', 'val', [$result['direccion']]));
      $response->addCommand(new InvokeCommand('[data-drupal-selector="edit-comprador-telefono"]', 'val', [$result['numero']]));
    }
    
    return $response;
  }
