  const PLAN_PERSONALIZADO_ID = 9940;
  function ks_plan_change(array &$form,\Drupal\Core\Form\FormStateInterface $form_state) {
    $response = new AjaxResponse();
    
    $idPlan = trim($form_state->getValue('condiciones_plan'));
    if(!$idPlan) $idPlan = 0;
    
    $selectedPlan = null;    
    $planes = Folio::koe_session('planes');
    foreach($planes as $plan){
      if($plan['idPlan'] == $idPlan){
        $selectedPlan = $plan;
        break;
      }
    }
    
    $personalizado = ($idPlan == PLAN_PERSONALIZADO_ID);
    
    $response->addCommand(new InvokeCommand('[data-drupal-selector="edit-condiciones-precio"]', 'prop', ['readonly', !$personalizado]));
    $response->addCommand(new InvokeCommand('[data-drupal-selector="edit-condiciones-enganche"]', 'prop', ['readonly', !$personalizado]));
    $response->addCommand(new InvokeCommand('[data-drupal-selector="edit-condiciones-saldo"]', 'prop', ['readonly', !$personalizado]));
    $response->addCommand(new InvokeCommand('[data-drupal-selector="edit-condiciones-parcialidades"]', 'prop', ['readonly', !$personalizado]));
    $response->addCommand(new InvokeCommand('[data-drupal-selector="edit-pagare-cuotas"]', 'prop', ['readonly', !$personalizado]));
    $response->addCommand(new InvokeCommand('[data-drupal-selector="edit-pagare-monto"]', 'prop', ['readonly', !$personalizado]));
    
    if(!$personalizado){      
      $total = (intval($selectedPlan['cantidadCuotas']) > 1)? ($selectedPlan['cantidadCuotas']*$selectedPlan['valorcouta'])+$selectedPlan['valorInicial']:$selectedPlan['valorInicial'];
      $response->addCommand(new InvokeCommand('[data-drupal-selector="edit-condiciones-precio"]', 'val', [$total]));
      $response->addCommand(new InvokeCommand('[data-drupal-selector="edit-condiciones-enganche"]', 'val', [$selectedPlan['valorInicial']]));
      $response->addCommand(new InvokeCommand('[data-drupal-selector="edit-condiciones-saldo"]', 'val', [(intval($selectedPlan['cantidadCuotas']) > 1)? $total-$selectedPlan['valorInicial']:0]));
      $response->addCommand(new InvokeCommand('[data-drupal-selector="edit-condiciones-parcialidades"]', 'val', [(intval($selectedPlan['cantidadCuotas']) > 1)? $selectedPlan['cantidadCuotas'].' mensualidades de '.$selectedPlan['valorcouta']:0]));
      $response->addCommand(new InvokeCommand('[data-drupal-selector="edit-pagare-cuotas"]', 'val', [$selectedPlan['cantidadCuotas']]));
      $response->addCommand(new InvokeCommand('[data-drupal-selector="edit-pagare-monto"]', 'val', [$selectedPlan['valorcouta']]));
      $response->addCommand(new InvokeCommand('[data-drupal-selector="edit-condiciones-precio"]', 'change'));
      $response->addCommand(new InvokeCommand('[data-drupal-selector="edit-condiciones-saldo"]', 'change'));
    }
      
    return $response;
  }
  function ks_precio_change(array &$form,\Drupal\Core\Form\FormStateInterface $form_state) {
    $response = new AjaxResponse();
    
    $letras = ks_numero_a_letras(intval($form_state->getValue('condiciones_precio')));
    $response->addCommand(new InvokeCommand('[data-drupal-selector="edit-clausulas-costo"]', 'val', [$letras]));
    
    return $response;
  }
  function ks_edad_change(array &$form,\Drupal\Core\Form\FormStateInterface $form_state) {
    $response = new AjaxResponse();
    
    $beneficiarios = ['uno', 'dos'];
    foreach($beneficiarios as $beneficiario){
      $edad = $form_state->getValue('beneficiarios_'.$beneficiario.'_edad');
      $servicio = ($edad < 13)? 'KIDS':'ADULTO';
      
      $response->addCommand(new InvokeCommand('[data-drupal-selector="edit-beneficiarios-'.$beneficiario.'-servicio"]', 'val', [$servicio]));
    }
    
    return $response;
  }
  function ks_servicio_change(array &$form,\Drupal\Core\Form\FormStateInterface $form_state) {
    $response = new AjaxResponse();
    
    $beneficiarios = ['uno', 'dos'];
    foreach($beneficiarios as $beneficiario){
      $servicio = $form_state->getValue('beneficiarios_'.$beneficiario.'_servicio');
      $kids = ($servicio == 'KIDS');
      $min = $kids? 7:13;
      $max = $kids? 12:99;
      
      $response->addCommand(new InvokeCommand('[data-drupal-selector="edit-beneficiarios-'.$beneficiario.'-edad"]', 'attr', ['min', $min]));
      $response->addCommand(new InvokeCommand('[data-drupal-selector="edit-beneficiarios-'.$beneficiario.'-edad"]', 'attr', ['max', $max]));
    }
    
    return $response;
  }
  
  //Generic
  //PDF  
  function koe_pdf_write($pdf, $data, $campo, $posicion, $pagareBln = false){
    $input = isset($data[$campo])? $data[$campo]:'';
    if(is_array($input)) $input = reset($input);
    $input = mb_convert_encoding($input, 'ISO-8859-1', 'UTF-8');
        
    $i = 1;
    while(isset($posicion['x'.$i])){
      $valor = $input;
      
      if(isset($posicion['pagare'.$i]) && !$pagareBln) $valor = '';
      else if(isset($posicion['formato'.$i])){
        switch($posicion['formato'.$i]){
          case 'zerofill':
            $valor = str_pad($input, 2, '0', STR_PAD_LEFT);
          break;
          case 'date':
            $date = date_create($input);
            $valor = date_format($date, 'd/m/Y');
          break;
          case 'split_date':					
            $date = date_create($input);
            
            //Día
            $pdf->SetXY($posicion['x'.$i]-11, $posicion['y'.$i]);
            $pdf->Write(0, date_format($date, 'j'));
            
            //Año
            $pdf->SetXY($posicion['x'.$i]+22, $posicion['y'.$i]);
            $pdf->Write(0, date_format($date, 'Y'));
            
            //Mes
            $mesIdx = intval(date_format($date, 'n'))-1;
            $meses = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];					
            $valor = $meses[$mesIdx];
          break;
          case 'split_date_bienvenida':					
            $date = date_create($input);
            
            //Día
            $pdf->SetXY($posicion['x'.$i]-22, $posicion['y'.$i]);
            $pdf->Write(0, date_format($date, 'j'));
            
            //Año
            $pdf->SetXY($posicion['x'.$i]+38, $posicion['y'.$i]);
            $pdf->Write(0, date_format($date, 'Y'));
            
            //Mes
            $mesIdx = intval(date_format($date, 'n'))-1;
            $meses = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];					
            $valor = $meses[$mesIdx];
          break;
          case 'split_date_contrato':					
            $date = date_create($input);
            
            //Día
            $pdf->SetXY($posicion['x'.$i]-14, $posicion['y'.$i]);
            $pdf->Write(0, date_format($date, 'j'));
            
            //Año
            $pdf->SetXY($posicion['x'.$i]+14, $posicion['y'.$i]);
            $pdf->Write(0, date_format($date, 'Y'));
            
            //Mes	
            $valor = date_format($date, 'n');
          break;
          case 'currency':
            $valor = '$'.number_format(floatval($input), 2);
          break;
          case 'number':
            $valor = number_format(floatval($input), 2);
          break;
          case 'yes_no':
            $valor = 'X';
            if(strtolower($input) == 'no') $posicion['x'.$i] += 14.3;
          break;
          case 'checkbox':
            $valor = empty($input)? '':'X';
          break;
          case 'wordwrap_chequeo':
            $lineas = explode("\n", wordwrap($input, 96));
            for($j = 1; $j < count($lineas); $j++){
              $pdf->SetXY($posicion['x'.$i], $posicion['y'.$i]+($j*5.2));
              $pdf->Write(0, $lineas[$j]);
            }
            $valor = $lineas[0];
          break;
          case 'wordwrap_bienvenida':
            $lineas = explode("\n", wordwrap($input, 123));
            for($j = 1; $j < count($lineas); $j++){
              $pdf->SetXY($posicion['x'.$i], $posicion['y'.$i]+($j*5.2));
              $pdf->Write(0, $lineas[$j]);
            }
            $valor = $lineas[0];
          break;
          case 'facturacion_metodo_pago':
            $valor = empty($input)? '':'X';
            if(strtolower($input) == 'ppd') $posicion['x'.$i] += 83.5;
          break;
          case 'facturacion_formas_pago':
            $valor = empty($input)? '':'X';
            switch(strtolower($input)){
              case 'cheque':
                $posicion['x'.$i] += 42;
              break;
              case 'credito':
                $posicion['x'.$i] += 26;
              break;
              case 'otro':
                $posicion['x'.$i] += 54;
              break;
              case 'transferencia':
                $posicion['x'.$i] += 89.3;
              break;
              case 'efectivo':
                $posicion['x'.$i] += 0;
              break;
            }
          break;
          case 'facturacion_regimen':
            $valor = empty($input)? '':'X';
            switch(strtolower($input)){
              case 'asalariado':
                $posicion['y'.$i] += 7.2;
              break;
              case 'arrendamiento':
                $posicion['x'.$i] += 74.5;
              break;
              case 'intereses':
                $posicion['x'.$i] += 74.5;
                $posicion['y'.$i] += 7.2;
              break;
              case 'fiscal':
                $posicion['x'.$i] += 74.5;
                $posicion['y'.$i] += 14.5;
              break;
              case 'profesionales':
                $posicion['y'.$i] += 14.5;
              break;
              case 'morales':
                $posicion['y'.$i] += 22;
              break;
              case 'nolucrativas':
                $posicion['x'.$i] += 74.5;
                $posicion['y'.$i] += 22;
              break;
            }
          break;
          case 'entrega_tipo':
            $valor = empty($input)? '':'X';
            switch(strtolower($input)){
              case 'cheque':
                $posicion['x'.$i] += 24.5;
              break;
              case 'tarjeta':
                $posicion['x'.$i] += 44.5;
              break;
              case 'transferencia':
                $posicion['x'.$i] += 69;
              break;              
            }
          break;
        }
      }
      
      $pdf->SetXY($posicion['x'.$i], $posicion['y'.$i]);
      $pdf->Write(0, $valor);
      $i++;
    }
  }
  
  //File  
  function koe_pdf_procesar($webform_id, $data, $test = false){
    $mapas = Pdf::listar($webform_id);
    
    $mapa = array_shift($mapas);    
    $campos = unserialize($mapa['campos']);
    
    $folio = ($webform_id == 'contrato')? (isset($data['folio'])? $data['folio']:0):Folio::koe_folio($webform_id);//Contemplando el caso de edición de contrato
    
    $digitalBln = ($webform_id == 'contrato' && isset($data['condiciones_material']))? ($data['condiciones_material'] == 'digital'):false;
    $pagareBln = ($webform_id == 'contrato' && isset($data['condiciones_saldo']))? (intval($data['condiciones_saldo']) > 0):false;
    $beneficiariosDosBln = ($webform_id == 'contrato' && isset($data['beneficiarios_dos']))? (intval($data['beneficiarios_dos']) > 0):false;
    $codeudorBln = ($pagareBln && intval($data['pagare']) > 0);
    
    $templatesLocation = 'public://pdf/templates/';
    $template = Drupal::service('file_system')->realpath($templatesLocation.$webform_id.'.pdf');
      
    $pdf = new Fpdi();
    $pdf->SetMargins(0,0,0);
    $pdf->SetAutoPageBreak(false, 0);
    $pdf->setSourceFile($template);
    $pdf->SetFont('Helvetica');
    
    $pdf->AddPage();	
    $page = $pdf->importPage($digitalBln? 2:1);
    $pdf->useTemplate($page, ['adjustPageSize' => true]);
    
    if($webform_id == 'contrato'){//folio
      $pdf->SetFontSize(15);
      $pdf->SetTextColor(255, 0, 0);
      $pdf->SetXY(198, 20.1);
      $pdf->Write(0, $folio);
    }elseif($webform_id == 'entrega'){
      $pdf->SetFontSize(24);
      $pdf->SetXY(181, 35.7);
      $pdf->Write(0, $folio);
    }
    
    $pdf->SetFontSize(8);
    $pdf->SetTextColor(0, 0, 0);
    
    
    foreach($campos as $campo => $posicion){
      if((!$beneficiariosDosBln && stripos($campo, 'beneficiarios_dos') !== false) || (!$codeudorBln && (stripos($campo, 'pagare_nacimiento') !== false || stripos($campo, 'pagare_ingreso') !== false))){
        continue;
      }
      koe_pdf_write($pdf, $data, $campo, $posicion, $pagareBln);		
    }
    
    if($webform_id == 'contrato'){//Página Dos
      $mapa = array_shift($mapas);      
      $campos = unserialize($mapa['campos']);
      
      $pdf->AddPage();
      
      $pageNumber = 0;
      if($pagareBln){
        $pageNumber = $digitalBln? 4:3;
      }else{
        $pageNumber = $digitalBln? 6:5;
      }
      
      $page = $pdf->importPage($pageNumber);
      $pdf->useTemplate($page, ['adjustPageSize' => true]);
      
      $pdf->SetFontSize(5);
      
      foreach($campos as $campo => $posicion){
        koe_pdf_write($pdf, $data, $campo, $posicion, $pagareBln);		
      }
    }
      
    $file_path = Pdf::getFileRoute($webform_id, $folio, true);
    
    $pdf->Close();
    $pdf->Output('F', $file_path);
    
    return Pdf::getFileRoute($webform_id, $folio, !$test);
  }
  
  function ks_webform_submission_insert(EntityInterface $submission){
    $webform = $submission->getWebform();
    $webform_id = $webform->id();
    $data = $submission->getData();
    if(Pdf::hasPdf($webform_id) && $submission->isCompleted()){      
      $folio = isset($data['folio'])? $data['folio']:null;
      if(is_null($folio)) return;
      
      $matricula = null;
      if($webform_id != 'contrato'){
        Folio::koe_folio($webform_id, true);//Folio taken
        $matricula = isset($data[$webform_id.'_matricula'])? $data[$webform_id.'_matricula']:(isset($data[$webform_id.'_contrato'])? $data[$webform_id.'_contrato']:null);
      }
      
      $google_drive_url = '';
      try{          
          $pdf = Pdf::getFileRoute($webform_id, $folio, true);
          if(file_exists($pdf)){            
            $gfile = Pdf::processFile($pdf, $webform_id, $matricula);
            ddm($gfile);
            if(!is_null($gfile)){
              $google_drive_url = $gfile->webViewLink;
            }
          }          
      }catch(\Exception $e){
        Drupal::logger('ks')->warning($e->getMessage());
      }
      
      if($webform_id == 'contrato'){
        $takeFolio = true;
        $values = [
          'uid' => Drupal::currentUser()->id(),
          'field_folio' => $folio,
          'field_status' => 1,
          'field_submission' => $submission->id(),
          'field_gfile' => $google_drive_url,
          'field_cliente' => $data['comprador_nombre'],
        ];
        
        $contrato_id = isset($data['contrato_id'])? (int) $data['contrato_id']:0;          
        if($contrato_id){
          $contrato = Contrato::load($contrato_id);
          $status = $contrato->field_status->value;
          if($status == 5){
            $values['field_precursor'] = $contrato->field_folio->value;
            $values['field_sisk'] = $contrato->field_sisk->value;
            
            $contrato->field_sustitucion = $folio;
            $contrato->save();
            Folio::koe_contrato_status_update($contrato->field_folio->value, 7);
            
            $contrato = Contrato::create($values);
          }elseif($status == 3){
            $takeFolio = false;
            $contrato->field_status = 1;
            $contrato->field_submission = $values['field_submission'];
            $contrato->field_gfile = $values['field_gfile'];
            $contrato->field_cliente = $values['field_cliente'];          
          }
        }else{
          $contrato = Contrato::create($values);
        }
              
        $contrato->save();
        if($takeFolio){
          Folio::koe_folio($webform_id, true);
        }
      }
    }elseif($webform_id == 'aceptacion'){      
      $folio = isset($data['folio'])? $data['folio']:null;
      if(is_null($folio)) return;
      
      $contrato = Folio::koe_get_contrato($folio);
      if (!$contrato){
        return;
      }
      
      $status = $contrato->field_status->value;
      if(!in_array($status, [1,8,6])){
        return;
      }
      
      $submission = $contrato->field_submission->entity;
      $submission_data = $submission->getData();
      
      $data['attachment_url'] = $submission_data['attachment_url'];
      
      $saldo = intval($submission_data['condiciones_saldo']);
      $codeudor = intval($submission_data['pagare']);
      $toCodeudor = ($status != 6 && $saldo > 0 && $codeudor == 1);
      
      if($toCodeudor){
        $data['pagare_aval'] = $submission_data['pagare_aval'];
        $data['pagare_correo'] = $submission_data['pagare_correo'];
        $data['pagare_rfc'] = $submission_data['pagare_rfc'];
      }
      
      $precursor = isset($data['precursor'])? $data['precursor']:null;
      if($precursor && $toCodeudor){
        $status = ($status == 1)? 8:6;
      }else{
        if($status == 8){
          $status = $precursor? 6:2;
        }else{
          $status = $toCodeudor? 8:2;
        }        
      }      
      
      Folio::koe_contrato_status_update($folio, $status, $data);
    }
  }
  
  function ks_cron(){
    $queue = Drupal::queue('ks_queue');
    
    $previewsLocation = 'public://pdf/previews/';
    $path = Drupal::service('file_system')->realpath($previewsLocation);
    
    $fileSystemIterator = new \FilesystemIterator($path);
    $now = time();
    foreach ($fileSystemIterator as $file) {
      if ($now - $file->getMTime() >= 60 * 60 * 24 * 30){// 30 days 
        $item = new \stdClass();
        $item->path = $file->getPathname();
        $queue->createItem($item);
      }
    }
    
    //Correo de aceptación
    Drupal::logger('ks')->notice('Ejecutando ks_correo_procesar...');
    ks_correo_procesar_v2();
  }

  /**
   * Builds the IMAP query for acceptance declarations.
   */
  function ks_correo_busqueda_aceptacion(?\DateTimeInterface $since = null): SearchExpression {
    $search = new SearchExpression();
    $search->addCondition(new Unseen());
    $search->addCondition(new Subject('Aceptación'));
    $search->addCondition(new Subject('Contrato'));
    $search->addCondition(new Subject('ON-'));
    $search->addCondition(new Body('Yo,'));
    if ($since) {
      $search->addCondition(new Since($since));
    }

    return $search;
  }

  /**
   * Processes acceptance declarations from INBOX and Gmail Spam from the
   * configured activation date onward.
   */
  function ks_correo_procesar_v2(): void {
    $username = getenv('KS_ACCEPTANCE_IMAP_USER');
    $password = getenv('KS_ACCEPTANCE_IMAP_PASSWORD');
    if (!$username || !$password) {
      Drupal::logger('ks')->error('Acceptance IMAP credentials are not configured.');
      return;
    }

    try {
      $server = new Server('imap.gmail.com', '993', '/imap/ssl/novalidate-cert');
      $connection = $server->authenticate($username, $password);
    }
    catch (\Throwable $exception) {
      Drupal::logger('ks')->error('Unable to connect to the acceptance mailbox: @message', ['@message' => $exception->getMessage()]);
      return;
    }

    $processing_since = getenv('KS_ACCEPTANCE_PROCESSING_SINCE');
    if (!$processing_since) {
      Drupal::logger('ks')->error('Acceptance IMAP processing start date is not configured.');
      return;
    }
    try {
      $since = new \DateTimeImmutable($processing_since, new \DateTimeZone('America/Mexico_City'));
    }
    catch (\Exception $exception) {
      Drupal::logger('ks')->error('Invalid KS_ACCEPTANCE_PROCESSING_SINCE value: @message', ['@message' => $exception->getMessage()]);
      return;
    }
    $mailboxes = [
      ['name' => 'INBOX', 'since' => $since],
      ['name' => getenv('KS_ACCEPTANCE_SPAM_MAILBOX') ?: '[Gmail]/Spam', 'since' => $since],
    ];

    $processed_store = Drupal::keyValue('ks.acceptance_mail_processed');
    $error_store = Drupal::keyValue('ks.acceptance_mail_errors');

    foreach ($mailboxes as $mailbox_config) {
      try {
        $mailbox = $connection->getMailbox($mailbox_config['name']);
        $messages = $mailbox->getMessages(ks_correo_busqueda_aceptacion($mailbox_config['since']));
      }
      catch (\Throwable $exception) {
        Drupal::logger('ks')->error('Unable to query acceptance mailbox @mailbox: @message', ['@mailbox' => $mailbox_config['name'], '@message' => $exception->getMessage()]);
        continue;
      }

      foreach ($messages as $message) {
        $message_key = hash('sha256', $mailbox_config['name'] . ':' . $message->getNumber());
        if ($processed_store->has($message_key)) {
          $message->markAsSeen();
          continue;
        }

        $error = '';
        try {
          $subject = $message->getSubject();
          if (!preg_match('/ON\D+([\d]+)/im', $subject, $matches)) {
            throw new \RuntimeException('El formato del folio no es válido.');
          }

          $folio = (int) $matches[1];
          $contrato = Folio::koe_get_contrato($folio);
          if (!$contrato) {
            throw new \RuntimeException('El folio no es válido.');
          }
          if (!in_array((int) $contrato->field_status->value, [1, 8, 6], true)) {
            throw new \RuntimeException('El contrato no admite una aceptación en su estatus actual.');
          }

          $body = $message->getBodyText();
          if (!preg_match('/Yo,\W+([^,]+)/im', $body, $matches)) {
            throw new \RuntimeException('No se detectó el nombre del aceptante.');
          }
          $data = ['folio' => $folio, 'comprador_nombre' => trim($matches[1])];
          if (!preg_match('/pasaporte\W+([^,]+)/im', $body, $matches)) {
            throw new \RuntimeException('No se detectó el documento del aceptante.');
          }
          $data['comprador_rfc'] = trim($matches[1]);
          if ($contrato->field_precursor->value) {
            $data['precursor'] = $contrato->field_precursor->value;
          }

          $webform = Webform::load('aceptacion');
          $values = ['webform_id' => $webform->id(), 'data' => $data];
          $errors = WebformSubmissionForm::validateFormValues($values);
          if ($errors) {
            throw new \RuntimeException('El correo no cumple la validación del formulario de aceptación.');
          }

          WebformSubmissionForm::submitFormValues($values);
          $processed_store->set($message_key, ['folio' => $folio, 'processed' => time()]);
          $message->markAsSeen();
        }
        catch (\Throwable $exception) {
          $error = $exception->getMessage();
          Drupal::logger('ks')->warning('Acceptance email remains unread for retry. Mailbox: @mailbox. Error: @message', ['@mailbox' => $mailbox_config['name'], '@message' => $error]);
        }

        if ($error && !$error_store->has($message_key)) {
          $error_store->set($message_key, ['error' => $error, 'reported' => time()]);
          $mailManager = Drupal::service('plugin.manager.mail');
          $mailManager->mail('ks', 'ks_correo_procesar', 'koemasterweb@gmail.com,sandra.rincon@koe.la', Drupal::languageManager()->getDefaultLanguage()->getId(), ['body' => 'El sistema no pudo procesar una aceptación: ' . $error, 'subject' => 'Error procesando aceptación por correo'], null, true);
        }
      }
    }

    $connection->expunge();
  }
  
  function ks_correo_procesar(){
    $username = getenv("KS_ACCEPTANCE_IMAP_USER");
    $password = getenv("KS_ACCEPTANCE_IMAP_PASSWORD");
    $server = new Server('imap.gmail.com', '993', '/imap/ssl/novalidate-cert');
    $connection = $server->authenticate($username, $password);    
    Drupal::logger('ks')->notice(print_r($connection, true));
    
    $search = new SearchExpression();
    $search->addCondition(new Unseen());
    $search->addCondition(new Subject('Aceptación'));
    $search->addCondition(new Subject('Contrato'));
    $search->addCondition(new Subject('ON-'));
    $search->addCondition(new Body('Yo,'));
    
    $error = '';
    
    $mailbox = $connection->getMailbox('INBOX');
    $messages = $mailbox->getMessages($search);
    Drupal::logger('ks')->notice(sprintf('Recibidos %s correos.', count($messages)));
    foreach ($messages as $message) {
      $subject = $message->getSubject();
      
      $matches = [];
      preg_match('/ON\D+([\d]+)/im', $subject, $matches, 0, 0);
      $folio = intval($matches[1], 10);
      $date_str = date('d/M/Y H:i:s');
      ddm($date_str.'- ks_correo_procesar - folio: '.$folio.'.');
      
      if(!$folio){
        $error = 'El formato del folio no es válido.';
      }
      
      $contrato = Folio::koe_get_contrato($folio);
      if (!$contrato) {
          $error = 'El folio no es válido.';
      }else{
        $status = $contrato->field_status->value;
        if (!in_array($status, [1,8,6])) {
            switch ($status) {
                case 2:
                    $error = 'El contrato ya ha sido registrado.';
                break;
                case 3:
                    $error = 'El contrato se encuentra en proceso de revisión con el Asesor.';
                break;
                case 4:
                    $error = 'Este contrato se encuentra cancelado.';
                break;
            }
        } else {            
            $data = ['folio' => $folio];
            if (isset($contrato->field_precursor->value) && $contrato->field_precursor->value) {
                $data['precursor'] = $contrato->field_precursor->value;
            }
            $body = $message->getBodyText();
            
            $matches = [];
            preg_match('/Yo,\W+([^,]+)/im', $body, $matches, 0, 0);
            $data['comprador_nombre'] = $matches[1];
            preg_match('/pasaporte\W+([^,]+)/im', $body, $matches, 0, 0);
            $data['comprador_rfc'] = $matches[1];            
            
            $webform = Webform::load('aceptacion');
            $values = ['webform_id' => $webform->id(), 'data' => $data];
            $errors = WebformSubmissionForm::validateFormValues($values);
            if (!empty($errors)) {
               $error = 'El nombre o número de documento no son válidos. (Significa que en el cuerpo del correo no se detectó la información esperada, procede revisar el correo de aceptación y validar que el formato se haya respetado).';
               ddm($date_str.' - body: '.$body);
               ddm($errors);
            }else{
                ddm('Sin errores');
                $webform_submission = WebformSubmissionForm::submitFormValues($values);// Descomentar esta línea para poner producción
            }
        }          
      }
      $message->markAsSeen();
      
      if($error){        
        $to = ['koemasterweb@gmail.com', 'sandra.rincon@koe.la'];
        $toList = $message->getTo();
        $ccList = $message->getCc();        
        foreach($toList as $item){          
          $to[] = $item->getFullAddress();
        }  
        foreach($ccList as $item){
          $to[] = $item->getFullAddress();
        }
        $to = implode(',', $to);
        
        $subject = 'Error procesando: '.$subject;
        $body = 'El sistema no pudo procesar la aceptación por la siguiente causa: '.$error;
        
        $mailManager = Drupal::service('plugin.manager.mail');
        $mail = $mailManager->mail('ks', 'ks_correo_procesar', $to, Drupal::languageManager()->getDefaultLanguage()->getId(), ['body' => $body, 'subject' => $subject], NULL, true);        
        $log = t(!$mail['result']? 'Se produjo un problema notificando a @to sobre un error al procesar una aceptación.':'Se notificó a @to sobre problemas procesando un correo de aceptación.', ['@to' => $to]);
        Drupal::logger('ks')->notice($log);
      }
    }
    
    $connection->expunge();
  }
  function ks_mail($key, &$message, $params) {
    switch ($key) {
      case 'ks_correo_procesar':
        $message['subject'] = $params['subject'];
        $message['body'][] = $params['body'];
        break;
    }
  }
  
  function ks_views_pre_render(ViewExecutable $view) {
    if (isset($view) && (in_array($view->storage->id(), ['contratos', 'bitacora']))) {
      $view->element['#attached']['library'][] = 'ks/ks';
    }
  }
  
  function ks_views_data_alter(array &$data) {    
    if (isset($data['contrato'])) {      
      $data['contrato']['contrato_status'] = [
        'title' => t('Contrato Status'),
        'field' => [
          'id' => 'ks_view_contrato_status',
        ],
      ];
      
      $data['contrato']['filial_filter'] = [
        'title' => t('Filtro por filial de usuario máster o submáster'),
        'filter' => [
          'id' => 'ks_view_filial_filter',
          'field' => 'field_submission',
          'title' => t('Filtro por filial de usuario máster o submáster'),
        ],
      ];
    }
    
    if (isset($data['webform_submission'])) {      
      $data['webform_submission']['bitacora_folio'] = [
        'title' => t('Bitácora Folio'),
        'field' => [
          'id' => 'ks_view_bitacora_folio',
        ],
      ];
      
      $data['webform_submission']['bitacora_subject'] = [
        'title' => t('Bitácora Subject'),
        'field' => [
          'id' => 'ks_view_bitacora_subject',
        ],
      ];
    }
    
  }
  
function ks_calcular_edad($nacimiento){
  $nacimiento = new DateTime($nacimiento);
  $now = new DateTime();
  $interval = $now->diff($nacimiento);
  return $interval->y;
}
  

function ks_numero_a_letras($num){
  function Unidades($local_num){
       switch($local_num)
       {
           case 1: return 'UN';
           case 2: return 'DOS';
           case 3: return 'TRES';
           case 4: return 'CUATRO';
           case 5: return 'CINCO';
           case 6: return 'SEIS';
           case 7: return 'SIETE';
           case 8: return 'OCHO';
           case 9: return 'NUEVE';
       }  
       return '';
   }
   
   function DecenasY($strSin, $numUnidades) {
        if ($numUnidades > 0){
            return $strSin . ' Y ' . Unidades($numUnidades);
          }
   
        return $strSin;
    }
   
   function Decenas($local_num){
   
        $decena = floor($local_num/10);
        $unidad = $local_num - ($decena * 10);
   
        switch($decena)
        {
            case 1:
                switch($unidad)
                {
                    case 0: return 'DIEZ';
                    case 1: return 'ONCE';
                    case 2: return 'DOCE';
                    case 3: return 'TRECE';
                    case 4: return 'CATORCE';
                    case 5: return 'QUINCE';
                    default: return 'DIECI' + Unidades($unidad);
                }
            case 2:
                switch($unidad)
                {
                    case 0: return 'VEINTE';
                    default: return 'VEINTI' + Unidades($unidad);
                }
            case 3: return DecenasY('TREINTA', $unidad);
            case 4: return DecenasY('CUARENTA', $unidad);
            case 5: return DecenasY('CINCUENTA', $unidad);
            case 6: return DecenasY('SESENTA', $unidad);
            case 7: return DecenasY('SETENTA', $unidad);
            case 8: return DecenasY('OCHENTA', $unidad);
            case 9: return DecenasY('NOVENTA', $unidad);
            case 0: return Unidades($unidad);
        }
    }
    
    function Centenas($local_num, $caller = '') {      
         $centenas = floor($local_num / 100);
         $decenas = $local_num - ($centenas * 100);
    
         switch($centenas)
         {
             case 1:
                 if ($decenas > 0){
                     return 'CIENTO ' . Decenas($decenas);
                   }
                 return 'CIEN';
             case 2: return 'DOSCIENTOS ' . Decenas($decenas);
             case 3: return 'TRESCIENTOS ' . Decenas($decenas);
             case 4: return 'CUATROCIENTOS ' . Decenas($decenas);
             case 5: return 'QUINIENTOS ' . Decenas($decenas);
             case 6: return 'SEISCIENTOS ' . Decenas($decenas);
             case 7: return 'SETECIENTOS ' . Decenas($decenas);
             case 8: return 'OCHOCIENTOS ' . Decenas($decenas);
             case 9: return 'NOVECIENTOS ' . Decenas($decenas);
         }
    
         return Decenas($decenas);
     }
     
     function Seccion($local_num, $divisor, $strSingular, $strPlural) {
          $cientos = floor($local_num / $divisor);          
          $resto = $local_num - ($cientos * $divisor);
     
          $letras = '';
     
          if ($cientos > 0){
              if ($cientos > 1){
                  $letras = Centenas($cientos, 'seccion') . ' ' . $strPlural;
              }else{
                  $letras = $strSingular;
                }
     }
          if ($resto > 0){
              $letras .= '';
            }
     
          return $letras;
      }
      
      function Miles($local_num) {
           $divisor = 1000;
           $cientos = floor($local_num / $divisor);
           $resto = $local_num - ($cientos * $divisor);
      
           $strMiles = Seccion($local_num, $divisor, 'UN MIL', 'MIL');           
           $strCentenas = Centenas($resto, 'miles');
      
           if($strMiles == ''){
               return $strCentenas;
             }
      
           return $strMiles . ' ' . $strCentenas;
       }
      
   function Millones($local_num) {
        $divisor = 1000000;
        $cientos = floor($local_num / $divisor);
        $resto = $local_num - ($cientos * $divisor);
   
        $strMillones = Seccion($local_num, $divisor, 'UN MILLON DE', 'MILLONES DE');
        $strMiles = Miles($resto);
   
        if($strMillones == ''){
            return $strMiles;
        }
   
        return $strMillones . ' ' . $strMiles;
    }
    
    function Centavos($centavos, $moneda){
            if ($centavos > 9){
            return $centavos . '/100 ' . $moneda;
          }
        else{
            return '0' . $centavos . '/100 ' . $moneda;
          }
    }
   
   $data = [
       'numero' => $num,
       'enteros' => floor($num),
       'centavos' => (((round($num * 100)) - (floor($num) * 100))),
       'letrasCentavos' => '',
       'letrasMonedaPlural' => ' DÓLARES',
       'letrasMonedaSingular' => ' DÓLARES',
       'letrasMonedaCentavoPlural' => 'USD',
       'letrasMonedaCentavoSingular' => 'USD',
   ];
   
   if (true) {
        $data['letrasCentavos'] = ' ';// . Centavos($data['centavos'], $data['letrasMonedaCentavoPlural']);
    }
   
    if($data['enteros'] == 0){
        return 'CERO ' . $data['letrasMonedaPlural'] . $data['letrasCentavos'];
      }
    if ($data['enteros'] == 1){
        return Millones($data['enteros']) . $data['letrasMonedaPlural'] . $data['letrasCentavos'];
      }
    else{
        return Millones($data['enteros']) . $data['letrasMonedaPlural'] . $data['letrasCentavos'];
      }
   
}
